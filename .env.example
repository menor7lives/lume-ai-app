# Lume AI — configuração
#
# A chave de conexão é OPCIONAL aqui: você também pode colar direto na
# tela de Configurações do Lume AI (fica salva só no seu PC, em data/settings.json).
#
# Crie sua chave gratuita em: https://aistudio.google.com/apikey
LUME_API_KEY=

# Porta do servidor local (padrão: 3000)
PORT=3000

# Endereço de escuta. 127.0.0.1 = só este computador (recomendado).
# Use 0.0.0.0 se quiser abrir o Lume AI para outros aparelhos da sua rede
# ou para hospedagem (Render, Railway, VPS etc.).
HOST=127.0.0.1

# Diretório de dados (conversas, configurações e imagens geradas).
# Em hospedagem, aponte para um volume persistente, por exemplo: /var/data
LUME_DATA_DIR=

# URL pública do site (usada no sitemap, canonical e Open Graph).
# Exemplo: https://lume-ai.onrender.com
PUBLIC_URL=

# Demonstração pública: cada visitante tem conversas isoladas em memória,
# configurações bloqueadas e limites do plano Grátis.
# Use true apenas em uma segunda instância/servidor público.
PUBLIC_MODE=false

# Link do servidor Discord do Lume AI (suporte, comunidade e vendas).
# Também pode ser configurado pela tela de Configurações.
DISCORD_URL=

# ---------------------------------------------------------------------------
# Planos e licenças
# ---------------------------------------------------------------------------

# Segredo usado para assinar os códigos de licença.
# OPCIONAL: se ficar vazio, o Lume AI cria um segredo local em data/.license-secret
# na primeira vez. Use uma frase longa e aleatória (mínimo 16 caracteres) se
# quiser controlar o segredo. NUNCA publique esse valor.
# Gere códigos com: node tools/gerar-licenca.js plus 30
LICENSE_SECRET=

# Desbloqueia um plano só para você (útil para testar/desenvolver).
# Valores: free | plus | pro  (deixe vazio para usar o plano ativado por código)
LUME_PLAN=

# Links de pagamento/checkout mostrados no botão "Assinar" de cada plano.
# Pode ser Mercado Pago, Stripe, Kiwify, WhatsApp etc.
CHECKOUT_PLUS_URL=
CHECKOUT_PRO_URL=
